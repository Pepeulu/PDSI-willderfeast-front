{
  "name": "wilderfeast",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib middleware.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib tests *.ts *.mts *.mjs *.json README.md",
    "format:check": "prettier --check app components lib tests *.ts *.mts *.mjs *.json README.md",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "8.72.2",
    "@vitest/coverage-istanbul": "^4.1.12",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^26.1.0",
    "prettier": "3.10.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  }
}
